# Local-only defaults. These credentials are unsafe for shared or production environments.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=football_market_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# UUID de la cuenta dueña de las fichas iniciales de jugadores nuevos.
MARKET_PRIMARY_ACCOUNT_ID=

# Optional exact proxy IPs, comma-separated, for browser request quotas.
# Trusted proxies must append the address of their immediate downstream peer to X-Forwarded-For.
TRUSTED_PROXY_IPS=
