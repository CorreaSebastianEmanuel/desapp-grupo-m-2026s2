    parser.add_argument('--stage-model',action='append',default=[])
    parser.add_argument('--stage-effort',action='append',default=[])
    if resume:
        parser.add_argument('--adopt-models',action='store_true')
        parser.add_argument('--dry-run',action='store_true')


