        assignment=models.directory(ROOT)/(selection['assignment_id']+'.json')
    else:
        index=models.directory(ROOT)/'bindings.json'
        bound=models.load_json(index).get('runs',{}) if index.exists() else {}
        parent=models.saved(ROOT,meta(task)['id'],run) if adopting and run in bound else None
        assignment=models.save(ROOT,selection,parent=parent)
    models.bind(ROOT,assignment,run)
    if adopting and state:
        # A resumed Codex session must not be relabeled with a new assignment.
        stage=state.get('current_step_id')
        if stage in models.STAGES:
            rewind_run(task,run,stage)
    feature=feature_for_task(task,allow_missing=True)
    if feature and state and state.get('current_step_id') in ('qa','qa_ready','review'):
        from scripts.agentflow_verification import readiness
        readiness(ROOT,feature)
    code,_=monitor_process(["specify","workflow","resume",run],task,run,assignment=assignment,new_session=adopting,provider=selected)
    if code==130: return code
    if code:
        field(task,"status","blocked")
        print(f"Resume failed. Inspect {(SPEC_RUNS/run/'state.json').relative_to(ROOT)}",file=sys.stderr)
        return code
    return finalize(task,meta(task),code)
