    if run in ("none","unknown",""): raise SystemExit("No resumable run; use start")
    guard_feedback(task)
    state=read_run_state(run)
    selection,adopting=models.resume_selection(ROOT,task,run,a,state)
    selected=resolved_resume_provider(selection,a)
    print(json.dumps(selection,indent=2))
    if getattr(a,'dry_run',False): return 0
    try: branch=ensure_feature_branch(task)
    except RuntimeError as error: raise SystemExit(str(error)) from error
    print(f"Feature branch: {branch}")
    bind_run_provider(run,selected,adopting)
    state=read_run_state(run)
    session_feature(task,head_ref=branch,allow_missing=bool(state and state.get("current_step_id")=="product"))
    recover_orphaned_run(task,run)
    field(task,"status","wip")
    print(f"Resuming {a.task.upper()} — run {run}")
