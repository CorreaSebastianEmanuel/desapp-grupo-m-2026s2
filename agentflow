ROOT = Path(__file__).resolve().parent
BACKLOG = ROOT / "backlog"
RUNS = ROOT / ".agentflow" / "runs"
FEEDBACK = ROOT / "backlog" / "feedback"
WORKFLOW = ROOT / ".agentflow" / "workflow.yml"
SPEC_RUNS = ROOT / ".specify" / "workflows" / "runs"
STEP_LABELS = {
    "product": "Product specification", "product_challenge": "Independent product challenge",
    "product_decision": "Product decision detection", "product_check": "Conditional human check",
    "architecture": "Architecture synthesis", "plan_ready": "Plan artifact gate",
    "tasks": "Validated implementation tasks", "tasks_ready": "Tasks artifact gate",
    "develop": "Development", "develop_ready": "Development artifact gate",
    "qa": "Independent QA", "qa_ready": "QA verdict gate", "review": "Final review",
}
STEP_ORDER = tuple(STEP_LABELS)
STAGE_ALIASES = {"product":"product","architecture":"architecture","development":"develop","develop":"develop","qa":"qa","review":"review"}
CHECKPOINT_ORDER = {"CP1": 1, "CP2": 2, "CP3": 3}
PRIORITY_ORDER = {"critical": 0, "high": 1, "medium": 2, "low": 3}
def config_int(name, default):
    try: match=re.search(rf"(?m)^{re.escape(name)}\s*=\s*(\d+)\s*$",(ROOT/".agentflow"/"config.toml").read_text(encoding="utf-8"))
    except OSError: return default
    return int(match.group(1)) if match else default
def config_value(name, default):
    try: match=re.search(rf'(?m)^{re.escape(name)}\s*=\s*"([^"\n]+)"\s*$',(ROOT/".agentflow"/"config.toml").read_text(encoding="utf-8"))
    except OSError: return default
    return match.group(1) if match else default
MAX_FEEDBACK_CYCLES = config_int("max_feedback_cycles",3)

def files(): return sorted(BACKLOG.glob("TASK-*.md"))
def meta(path):
    return task_metadata(path)
def find(task):
    try: return task_for_id(ROOT,task.upper())
    except RuntimeError as error: raise SystemExit(str(error)) from error
def field(path, key, value):
    text, _, spans = parsed_metadata(path)
    if key not in spans: raise SystemExit(f"Missing {key} in {path}")
    start, end = spans[key]
    path.write_bytes((text[:start] + value + text[end:]).encode('utf-8'))
def feedback_path(task): return FEEDBACK/f"{meta(task)['id']}.md"
def feedback_text(task):
    path=feedback_path(task)
    return path.read_text(encoding="utf-8") if path.exists() else "No human feedback has been recorded."
def task_context(task):
    return "Use docs/PRODUCT.md, docs/ARCHITECTURE.md, docs/CHECKPOINTS.md and the constitution.\n\n"+task.read_text(encoding="utf-8")+"\n\n## Human feedback\n\n"+feedback_text(task)
def slug(text): return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "task"
def task_branch(task):
    return expected_branch(task)
def dependency_ids(path):
    raw=meta(path).get("depends_on","none")
    return [] if raw in ("none","") else [x.strip().upper() for x in raw.split(",") if x.strip()]
def dependency_blockers(path):
    blockers=[]
    for ident in dependency_ids(path):
        try: state=meta(find(ident)).get("status","unknown")
        except SystemExit: state="missing"
        # A reviewed task has passed both automated verification gates and is
        # waiting only for the human-controlled merge. It may be developed
        # against in parallel, so only pre-review states block dependants.
        if state not in ("done","review"): blockers.append(f"{ident} ({state})")
    return blockers

def ready_tasks():
    """Return startable backlog tasks in delivery order."""
    candidates = [
        path for path in files()
        if meta(path).get("status") == "todo" and not dependency_blockers(path)
    ]
    return sorted(candidates, key=lambda path: (
        CHECKPOINT_ORDER.get(meta(path).get("checkpoint"), 99),
        PRIORITY_ORDER.get(meta(path).get("priority"), 99),
        meta(path).get("id", ""),
    ))

def review_pr_merged(task):
    """Return whether the task's deterministic branch was merged to the base branch."""
    if not shutil.which("gh"): return False
    result=subprocess.run(
        ["gh","pr","view",task_branch(task),"--json","state,mergedAt,baseRefName"],
        cwd=ROOT,text=True,capture_output=True,
    )
    if result.returncode: return False
    try: pr=json.loads(result.stdout)
    except json.JSONDecodeError: return False
    return bool(
        pr.get("state")=="MERGED" and pr.get("mergedAt")
        and pr.get("baseRefName") in ("main","master")
    )

def reconcile_merged_dependencies(path):
    """Persist merged reviewed dependencies after entering the new feature branch."""
    completed=[]
    dependencies=[]
    # Validate the entire dependency metadata set before the first write.
    for ident in dependency_ids(path):
        try:
            dependency=task_for_id(ROOT,ident)
            state=task_metadata(dependency).get("status")
        except RuntimeError as error:
            print(f"Merged dependency {ident} refused: {error}",file=sys.stderr)
            return []
        dependencies.append((ident,dependency,state))
    for ident,dependency,state in dependencies:
        if state!="review": continue
        try:
            if not review_pr_merged(dependency): continue
            complete_reviewed_task(ROOT,dependency,head_ref=task_branch(dependency))
        except RuntimeError as error:
            print(f"Merged dependency {ident} refused: {error}",file=sys.stderr)
            continue
        completed.append(ident)
    if completed:
        print("Merged dependencies reconciled: "+", ".join(completed))
    return completed
def agent(requested):
    """Resolve one explicit provider value to an installed CLI."""
    return providers.require(providers.normalize(requested))


def provider_for(a):
    """Canonical provider for a command: --provider / legacy --agent must
    agree when both are present; otherwise the repository default wins."""
    if getattr(a, "provider", None) is None and getattr(a, "agent", None) is None:
        return agent(config_value("default_provider", providers.DEFAULT_PROVIDER))
    return agent(providers.from_args(a))
def create(a):
    title = a.title or input("Task title: ").strip()
    if not title: raise SystemExit("Task title is required")
    outcome = a.outcome or input("Expected outcome: ").strip()
    nums = [int(meta(p)["id"].split("-")[1]) for p in files()]
    ident = f"TASK-{max(nums, default=0)+1:03d}"
    path = BACKLOG / f"{ident}-{slug(title)}.md"
    path.write_text(f"---\nid: {ident}\ntitle: {title}\ntype: task\ncheckpoint: {a.checkpoint}\npriority: {a.priority}\nstatus: todo\ndepends_on: none\nactive_run: none\n---\n\n## Outcome\n\n{outcome or title}\n", encoding="utf-8")
    print(f"Created {ident}: {path.relative_to(ROOT)}")
def backlog(_):
    print(f"{'ID':<10} {'STATE':<9} {'CP':<4} {'PRIORITY':<9} TITLE\n" + "-"*76)
    for p in files():
        m=meta(p); state=m['status']
        if state=="todo" and not dependency_blockers(p): state="ready"
        print(f"{m['id']:<10} {state:<9} {m['checkpoint']:<4} {m['priority']:<9} {m['title']}")
def next_task(_):
    ready=ready_tasks()
    if not ready:
        print("No tasks are ready. Every todo task has unfinished dependencies.")
        return 1
    path=ready[0]; m=meta(path)
    print(f"Next: {m['id']} — {m['title']}")
    print(f"Checkpoint: {m['checkpoint']} | Priority: {m['priority']} | Depends on: {m.get('depends_on','none')}")
    print(f"Start with: ./agentflow start {m['id']}")
    if len(ready)>1:
        print("Also ready: "+", ".join(meta(candidate)["id"] for candidate in ready[1:]))
    return 0
def status(a):
    path=find(a.task); m=meta(path)
    for k in ("id","title","checkpoint","priority","status","depends_on","active_run"): print(f"{k}: {m.get(k,'unknown')}")
    blockers=dependency_blockers(path)
    print(f"ready: {'yes' if not blockers and m.get('status')=='todo' else 'no'}")
    if blockers: print("blocked_by: "+", ".join(blockers))
    fp=feedback_path(path)
    if fp.exists(): print(f"feedback: {fp.relative_to(ROOT)} ({fp.read_text(encoding='utf-8').count('## Feedback ')} entries)")
    run=m.get("active_run","none")
    state=read_run_state(run)
    if state:
        current=state.get("current_step_id") or "pending"
        index=int(state.get("current_step_index",0))+1
        total=len(workflow_step_order(SPEC_RUNS/run/"workflow.yml"))
        updated=state.get("updated_at","unknown")
        print(f"workflow: {state.get('status','unknown')}")
        print(f"stage: {index}/{total} {STEP_LABELS.get(current,current)}")
        print(f"last_activity: {updated}")
        print(f"log: {(SPEC_RUNS/run/'log.jsonl').relative_to(ROOT)}")
def feature_for_task(task, allow_missing=False):
    association=resolve_feature(ROOT,task,allow_missing=allow_missing)
    return association.feature if association else None

def session_feature(task, head_ref=None, allow_missing=False):
    association=resolve_feature(ROOT,task,head_ref=head_ref,allow_missing=allow_missing)
    pointer=ROOT/".specify"/"feature.json"
    if association is None:
        pointer.unlink(missing_ok=True)
    else:
        pointer.parent.mkdir(parents=True,exist_ok=True)
        pointer.write_text(json.dumps({"feature_directory":association.feature.relative_to(ROOT).as_posix()})+"\n",encoding="utf-8")
    return association

def delivery_association(task, feature=None):
    branch=git("branch","--show-current").stdout.strip()
    association=resolve_feature(ROOT,task,head_ref=branch)
    if feature is not None and feature.resolve()!=association.feature:
        raise RuntimeError(f"Refusing caller feature {feature}; expected {association.feature}")
    for name in ("spec.md","plan.md","tasks.md"):
        contained_file(association.feature,name)
    require_reports(association)
    return association

def git(*args, capture=True):
    return subprocess.run(["git",*args],cwd=ROOT,text=True,capture_output=capture)

def ensure_feature_branch(task):
    expected=task_branch(task)
    current=git("branch","--show-current").stdout.strip()
    if current==expected: return expected
    if current not in ("main","master"):
        raise RuntimeError(f"Expected feature branch {expected}, found {current or 'detached HEAD'}")
    exists=git("show-ref","--verify","--quiet",f"refs/heads/{expected}").returncode==0
    switched=git("switch",expected) if exists else git("switch","-c",expected)
    if switched.returncode:
        raise RuntimeError(switched.stderr.strip() or switched.stdout.strip() or f"Cannot switch to {expected}")
    return expected

def read_run_state(run):
    if run in (None,"none","unknown",""): return None
    path=SPEC_RUNS/run/"state.json"
    try: return json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): return None

def graceful_interrupt(process, reader):
    """Stop the process group the way Ctrl+C would: SIGINT → wait → SIGTERM →
    wait → SIGKILL. A human interrupt and the stage budget share this helper so
    a timed-out stage receives the identical gentle escalation."""
    if os.name=="posix": os.killpg(process.pid,signal.SIGINT)
    else: process.send_signal(signal.CTRL_BREAK_EVENT)
    try: process.wait(timeout=10)
    except subprocess.TimeoutExpired:
        if os.name=="posix": os.killpg(process.pid,signal.SIGTERM)
        else: process.terminate()
        try: process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            if os.name=="posix": os.killpg(process.pid,signal.SIGKILL)
            else: process.kill()
            process.wait()
    reader.join(timeout=2)

def pause_stage_budget_run(run, step, elapsed_seconds, minutes):
    """Record a stage-timeout pause against the run's own state without
    blocking the task; resume re-dispatches the interrupted stage from its
    existing pointer instead of repeating completed stages."""
    state=read_run_state(run)
    if not state: return
    label=STEP_LABELS.get(step,step)
    stamp=datetime.now(timezone.utc).isoformat()
    state_path=SPEC_RUNS/run/"state.json"
    state["status"]="paused"
    state["error"]=f"Stage {label} exceeded stage_timeout_minutes={minutes}; interrupting safely"
    state["updated_at"]=stamp
    state_path.write_text(json.dumps(state,indent=2)+"\n",encoding="utf-8")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"stage_budget_exceeded","stage":step,
                              "elapsed_seconds":elapsed_seconds,"timestamp":stamp})+"\n")

def workflow_step_order(path):
    """Read top-level step IDs from either source or Spec Kit's YAML snapshot."""
    try: content=path.read_text(encoding="utf-8")
    except OSError: raise RuntimeError("Saved workflow is missing; refusing to guess rewind indexes")
    if "steps:" not in content: raise RuntimeError("Workflow has no step list")
    section=content.split("steps:",1)[1]
    first=re.search(r"(?m)^([ ]*)- id:",section)
    if not first: raise RuntimeError("Workflow has no step list")
    indentation=re.escape(first.group(1))
    steps=tuple(re.findall(r"(?m)^"+indentation+r"- id: ['\"]?([a-z_]+)['\"]?\s*$",section))
    if not steps or len(set(steps))!=len(steps): raise RuntimeError("Workflow step order is invalid")
    return steps

def run_ids():
    return {p.name for p in SPEC_RUNS.iterdir() if p.is_dir()} if SPEC_RUNS.exists() else set()

def latest_run():
    dirs=[p for p in SPEC_RUNS.iterdir() if p.is_dir()] if SPEC_RUNS.exists() else []
    return max(dirs,key=lambda p:p.stat().st_mtime).name if dirs else None

def process_alive(pid):
    try: os.kill(int(pid),0); return True
    except (OSError,TypeError,ValueError): return False

def recover_orphaned_run(task, run):
    """Turn a stale RUNNING state into PAUSED after proving our runner is gone."""
    state=read_run_state(run)
    if not state or state.get("status")!="running": return
    marker=RUNS/f"{meta(task)['id']}.process.json"
    try: process_data=json.loads(marker.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): process_data={}
    if process_data.get("run_id") == run and process_alive(process_data.get("pid")):
        raise SystemExit(f"Run {run} is still active in process {process_data['pid']}; use status instead of resume")
    state_path=SPEC_RUNS/run/"state.json"
    backup=SPEC_RUNS/run/"state.orphaned-running.json"
    if not backup.exists(): shutil.copy2(state_path,backup)
    state["status"]="paused"
    state["updated_at"]=datetime.now(timezone.utc).isoformat()
    state["error"]="Recovered by Agentflow after the owning process was interrupted"
    state_path.write_text(json.dumps(state,indent=2)+"\n",encoding="utf-8")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"orphaned_run_recovered","timestamp":state["updated_at"]})+"\n")
    print(f"Recovered orphaned run {run}: running → paused",flush=True)

def rewind_run(task, run, stage):
    state=read_run_state(run)
    if not state: return False
    marker=RUNS/f"{meta(task)['id']}.process.json"
    try: process_data=json.loads(marker.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): process_data={}
    if process_data.get("run_id")==run and process_alive(process_data.get("pid")):
        raise SystemExit("Cannot add feedback while the workflow is active; interrupt it with Ctrl+C first")
    recover_orphaned_run(task,run)
    state=read_run_state(run) or state
    order=workflow_step_order(SPEC_RUNS/run/"workflow.yml")
    if stage not in order: raise SystemExit(f"Stage {stage} is not present in the saved workflow")
    index=order.index(stage)
    stamp=datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    state_path=SPEC_RUNS/run/"state.json"
    shutil.copy2(state_path,SPEC_RUNS/run/f"state.before-feedback-{stamp}.json")
    state["status"]="paused"; state["current_step_index"]=index; state["current_step_id"]=stage
    retained=set(order[:index])
    if "product_check" in retained: retained.add("human_product_check")
    state["step_results"]={k:v for k,v in state.get("step_results",{}).items() if k in retained}
    state["error"]=None; state["updated_at"]=datetime.now(timezone.utc).isoformat()
    state.setdefault("inputs",{})["spec"]=task_context(task)
    state_path.write_text(json.dumps(state,indent=2)+"\n",encoding="utf-8")
    inputs_path=SPEC_RUNS/run/"inputs.json"
    try: inputs=json.loads(inputs_path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): inputs={"inputs":{}}
    inputs.setdefault("inputs",{})["spec"]=task_context(task)
    inputs_path.write_text(json.dumps(inputs,indent=2)+"\n",encoding="utf-8")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"feedback_rewind","stage":stage,"timestamp":state["updated_at"]})+"\n")
    return True

IMPACT_STAGE={'product':'product','architecture':'architecture','verification':'architecture',
              'implementation':'develop','qa':'qa','review':'review'}


def feedback_stage(impacts, requested):
    if not impacts: return None
    if any(impact not in IMPACT_STAGE for impact in impacts):
        raise RuntimeError('Unknown feedback impact category')
    order=('product','architecture','develop','qa','review')
    stage=min((IMPACT_STAGE[impact] for impact in impacts),key=order.index)
    if requested is not None and STAGE_ALIASES[requested] != stage:
        raise RuntimeError(f'Feedback impact requires {stage}; requested {requested} conflicts. Correct impact or stage before retrying; no state changed')
    return stage


def guard_feedback(task):
    from scripts.agentflow_verification import feedback_guard
    feedback_guard(ROOT,meta(task)['id'])


CHECK_ID_PATTERN=re.compile(r"[A-Za-z0-9_-]+")
def check_id(value):
    """--checks values must be check identifiers, canonical upper-case."""
    ident=value.strip().upper()
    if not CHECK_ID_PATTERN.fullmatch(value.strip()):
        raise argparse.ArgumentTypeError(f"Invalid check id {value!r}; expected [A-Za-z0-9_-]+")
    return ident


def add_feedback(a):
    task=find(a.task); m=meta(task)
    impacts=getattr(a,'impact',[]) or []
    stage=feedback_stage(impacts,a.stage)
    # Repeated --checks values are upper-cased by the parser; direct callers
    # get the same validation here, then one de-duplicated ordered list.
    checks=[]
    for ident in getattr(a,'checks',[]) or []:
        if not CHECK_ID_PATTERN.fullmatch(ident.strip()):
            raise SystemExit(f"Invalid check id {ident!r}; expected [A-Za-z0-9_-]+")
        ident=ident.strip().upper()
        if ident not in checks: checks.append(ident)
    message=a.message or input("Feedback: ").strip()
    if not message: raise SystemExit("Feedback text is required")
    run=m.get("active_run","none")
    if run not in ("none","unknown",""):
        marker=RUNS/f"{m['id']}.process.json"
        try: process_data=json.loads(marker.read_text(encoding="utf-8"))
        except (OSError,json.JSONDecodeError): process_data={}
        if process_data.get("run_id")==run and process_alive(process_data.get("pid")):
            raise SystemExit("Cannot add feedback while the workflow is active; interrupt it with Ctrl+C first")
    path=feedback_path(task); path.parent.mkdir(parents=True,exist_ok=True)
    existing=path.read_text(encoding="utf-8") if path.exists() else f"# Feedback — {m['id']}\n\n"
    count=existing.count("## Feedback ")
    if count>=MAX_FEEDBACK_CYCLES: raise SystemExit(f"Feedback limit reached ({MAX_FEEDBACK_CYCLES}); resolve or split the task before another cycle")
    stamp=datetime.now(timezone.utc).isoformat(timespec="seconds")
    author=os.environ.get("USER") or os.environ.get("USERNAME") or "human"
    scope=f"\n- Checks: {", ".join(checks)}" if checks else ""
    entry=f"## Feedback {count+1}\n\n- Time: {stamp}\n- Author: {author}\n- Restart from: {stage or "pending"}\n- Impact: {", ".join(impacts) if impacts else "pending"}\n- Required regressions: cited discrepancy plus required manifest checks{scope}\n\n{message}\n\n"
    path.write_text(existing+entry,encoding="utf-8")
    if stage is None:
        print(f'Recorded pending feedback in {path.relative_to(ROOT)}; classify its impact before resume. No workflow rewind performed')
        return
    rewound=run not in ("none","unknown","") and rewind_run(task,run,stage)
    if m.get("status")!="todo": field(task,"status","wip")
    print(f"Recorded feedback #{count+1} in {path.relative_to(ROOT)}")
    print(f"Workflow rewound to {STEP_LABELS[stage]}. Run: ./agentflow resume {m['id']}" if rewound else f"Feedback will be included when {m['id']} starts")

def history(a):
    task=find(a.task); m=meta(task)
    print(f"{m['id']} — {m['title']}\n")
    fp=feedback_path(task)
    print(fp.read_text(encoding="utf-8").rstrip() if fp.exists() else "No human feedback.")
    feature=feature_for_task(task,allow_missing=True)
    if feature and (feature/"handoffs").exists():
        print("\n# Agent handoffs")
        for handoff in sorted((feature/"handoffs").glob("*.md")):
            print(f"\n## {handoff.stem}\n{handoff.read_text(encoding='utf-8').rstrip()}")
    run=m.get("active_run","none"); state=read_run_state(run)
    if state:
        print("\n# Workflow")
        for step in workflow_step_order(SPEC_RUNS/run/"workflow.yml"):
            result=state.get("step_results",{}).get(step)
            mark=result.get("status","pending") if result else ("current" if step==state.get("current_step_id") else "pending")
            print(f"- {step}: {mark}")

def monitor_process(cmd, task, run_hint=None, assignment=None, new_session=False, provider=providers.DEFAULT_PROVIDER):
    """Run with inherited stdin, live output, durable logs, stage updates, and heartbeat."""
    provider=providers.normalize(provider)
    task_id=meta(task)["id"]
    RUNS.mkdir(parents=True,exist_ok=True)
    transcript=RUNS/f"{task_id}.live.log"
    before=run_ids()
    started=time.monotonic(); last_heartbeat=started; shown_step=None; run=run_hint
    print(f"Live log: {transcript.relative_to(ROOT)}",flush=True)
    child_env=os.environ.copy()
    # Each provider interposes its own forwarding shim through Spec Kit's
    # generic executable/extra-args overrides so workflow stages, prompts,
    # gates and metrics stay identical across providers.
    providers.env_overrides(child_env,provider,ROOT)
    child_env["AGENTFLOW_TASK_ID"]=task_id
    child_env["AGENTFLOW_METRICS_FILE"]=str(RUNS/f"{task_id}.metrics.jsonl")
    if new_session: child_env['AGENTFLOW_NEW_SESSION']='1'
    if assignment is not None:
        child_env['AGENTFLOW_ASSIGNMENT'] = str(assignment)
        import hashlib
        child_env['AGENTFLOW_ASSIGNMENT_SHA256']=hashlib.sha256(assignment.read_bytes()).hexdigest()
        if run_hint:
            models.bind(ROOT,assignment,run_hint)
            child_env['AGENTFLOW_RUN_ID'] = run_hint
        else:
            child_env['AGENTFLOW_ASSIGNMENT_PENDING'] = '1'
    process=subprocess.Popen(cmd,cwd=ROOT,stdin=None,stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,text=True,bufsize=1,env=child_env,
        start_new_session=os.name=="posix",
        creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if os.name=="nt" else 0)
    marker=RUNS/f"{task_id}.process.json"
    marker.write_text(json.dumps({"pid":process.pid,"run_id":run})+"\n",encoding="utf-8")
    def pump():
        assert process.stdout is not None
        with transcript.open("a",encoding="utf-8") as log:
            log.write(f"\n[{datetime.now().isoformat(timespec='seconds')}] specify workflow {'resume' if run_hint else 'run'}\n")
            log.flush()
            console=Console(full=os.environ.get("AGENTFLOW_CONSOLE")=="full")
