    changes=git("status","--porcelain")
    if changes.returncode: raise RuntimeError(changes.stderr.strip() or "git status failed")
    if changes.stdout.strip():
        staged=git("add","-A")
        if staged.returncode: raise RuntimeError(staged.stderr.strip() or "git add failed")
        commit=git("commit","-m",commit_message)
        if commit.returncode: raise RuntimeError(commit.stderr.strip() or commit.stdout.strip() or "git commit failed")
    else:
        previous=git("log","-1","--format=%s")
        if previous.returncode or previous.stdout.strip()!=commit_message:
            raise RuntimeError("Clean feature branch has no verified task commit to publish")
    pushed=git("push","-u","origin",branch)
    if pushed.returncode: raise RuntimeError(pushed.stderr.strip() or "git push failed")
    RUNS.mkdir(parents=True,exist_ok=True)
    body=RUNS/f"{task_meta['id']}-pr.md"
    body.write_text(
        f"## Agentflow delivery\n\nCloses the implementation work for `{task_meta['id']}`.\n\n"
        f"- Specification: `{feature.relative_to(ROOT)}/spec.md`\n"
        f"- Plan: `{feature.relative_to(ROOT)}/plan.md`\n"
        f"- Tasks: `{feature.relative_to(ROOT)}/tasks.md`\n"
        f"- QA: `{feature.relative_to(ROOT)}/qa-report.md` — PASS\n"
        f"- Final review: `{feature.relative_to(ROOT)}/review-report.md` — PASS\n\n"
        "The PR was created automatically after independent QA and final review. Merge remains human-controlled.\n\n"
        + task.read_text(encoding="utf-8").split("## Outcome",1)[-1].strip() + "\n",
        encoding="utf-8")
    pr=subprocess.run(["gh","pr","create","--base","main","--head",branch,"--title",f"{task_meta['id']}: {task_meta['title']}","--body-file",str(body)],cwd=ROOT,text=True,capture_output=True)
    if pr.returncode: raise RuntimeError(pr.stderr.strip() or "gh pr create failed")
    return pr.stdout.strip()

def finalize(task, task_meta, code, no_pr=False):
    # Invalid metadata cannot authorize even the automatic blocked transition.
    task_meta=meta(task)
    task_for_id(ROOT,task_meta.get("id",""))
    feature=None
    try:
        if code: raise RuntimeError(f"Workflow exited {code}")
        feature=delivery_association(task).feature
        if (feature/'verification.json').exists():
            from scripts.agentflow_evidence import finalize as finalize_evidence
            finalize_evidence(ROOT,task_meta['id'])
    except RuntimeError as error:
        field(task,"status","blocked")
        print(f"Verification failed: {error}",file=sys.stderr)
        return code or 1
    if no_pr:
        field(task,"status","review")
        print("QA and review passed. PR creation was disabled with --no-pr.")
        return 0
    try:
        url=publish(task,task_meta,feature)
        print(f"QA and review passed. Pull request created: {url}")
        return 0
    except RuntimeError as error:
        field(task,"status","blocked")
        print(f"Verification passed but PR publication failed: {error}",file=sys.stderr)
        return 1

