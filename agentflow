def bound_run_integration(run):
    """Integration recorded when the run was last started or adopted."""
    try:
        data=json.loads((SPEC_RUNS/run/"inputs.json").read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError):
        return None
    value=data.get("inputs",{}).get("integration")
    return value if isinstance(value,str) and providers.normalize(value) is not None and value in providers.PROVIDERS else value


def bind_run_provider(run, provider, adopting):
    """A run's saved integration follows only deliberate adoption.

    Spec Kit resumes replay the integration stored in inputs.json; replaying
    one provider's workflow through another CLI silently would mix provider
    sessions inside a run, so adoption rewrites the saved input atomically
    and logs the switch, while any non-adopted change is refused."""
    stored=bound_run_integration(run)
    if stored is None or stored==provider:
        return
    if not adopting:
        raise RuntimeError(f'Run inputs record integration {stored!r}; refusing to resume with provider '
                           f'{provider!r} without --adopt-models. Switch deliberately and start a fresh stage')
    path=SPEC_RUNS/run/"inputs.json"
    data=json.loads(path.read_text(encoding="utf-8"))
    data.setdefault("inputs",{})["integration"]=provider
    text=json.dumps(data,indent=2)+"\n"
    stamp=datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    shutil.copy2(path,SPEC_RUNS/run/f"inputs.before-provider-{stamp}.json")
    path.write_text(text,encoding="utf-8")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"provider_adoption","from":stored,"to":provider,
                              "timestamp":datetime.now(timezone.utc).isoformat()})+"\n")
    print(f"Provider adoption recorded: {stored} → {provider}")


def resolved_resume_provider(selection, a):
    """A run stays on its starting provider unless adoption is explicit.

    Agentflow stages persist per-run assignment bindings; replaying half of a
    workflow through a different CLI would mix providers inside one run, so
    mismatched --provider is refused outright and switching requires a new
    assignment generation (--adopt-models) instead of silent drift. CLI
    availability is not checked here so dry-run and pure selection probes work
    without provider binaries installed."""
    saved = providers.normalize(selection.get('provider'))
    requested = getattr(a, 'provider', None) if getattr(a, 'provider', None) is not None else getattr(a, 'agent', None)
    if requested is not None and providers.normalize(requested) != saved:
        raise RuntimeError(f'Run was started with provider {saved!r}; refusing to resume with {providers.normalize(requested)!r}. '
                           'Switch deliberately with --adopt-models and a new generation instead of mixing providers in one run')
    return saved


def resume(a):
