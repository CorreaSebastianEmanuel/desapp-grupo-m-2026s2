#!/usr/bin/env python3
from __future__ import annotations
import argparse, json, os, re, shutil, signal, subprocess, sys, threading, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
BACKLOG = ROOT / "backlog"
RUNS = ROOT / ".agentflow" / "runs"
FEEDBACK = ROOT / "backlog" / "feedback"
WORKFLOW = ROOT / ".agentflow" / "workflow.yml"
SPEC_RUNS = ROOT / ".specify" / "workflows" / "runs"
STEP_LABELS = {
    "product": "Product specification", "architecture": "Architecture plan",
    "checklist": "Requirements checklist", "tasks": "Implementation tasks",
    "analyze": "Consistency analysis", "develop": "Development",
    "converge": "Gap analysis", "remediate": "Remediation",
    "qa": "Independent QA", "review": "Final review",
}
STEP_ORDER = tuple(STEP_LABELS)
STAGE_ALIASES = {"product":"product","architecture":"architecture","development":"develop","develop":"develop","qa":"qa","review":"review"}
def config_int(name, default):
    try:
        match=re.search(rf"(?m)^{re.escape(name)}\s*=\s*(\d+)\s*$",(ROOT/".agentflow"/"config.toml").read_text(encoding="utf-8"))
        return int(match.group(1)) if match else default
    except OSError: return default
MAX_FEEDBACK_CYCLES = config_int("max_feedback_cycles",3)

def files(): return sorted(BACKLOG.glob("TASK-*.md"))
def meta(path):
    front = path.read_text(encoding="utf-8").split("---", 2)[1]
    return {k.strip(): v.strip().strip('"') for line in front.splitlines() if ":" in line for k,v in [line.split(":",1)]}
def find(task):
    found = list(BACKLOG.glob(f"{task.upper()}-*.md"))
    if len(found) != 1: raise SystemExit(f"Task {task.upper()} not found or ambiguous")
    return found[0]
def field(path, key, value):
    text = path.read_text(encoding="utf-8")
    text, n = re.subn(rf"(?m)^{re.escape(key)}:\s*.*$", f"{key}: {value}", text, count=1)
    if n != 1: raise SystemExit(f"Missing {key} in {path}")
    path.write_text(text, encoding="utf-8")
def feedback_path(task): return FEEDBACK/f"{meta(task)['id']}.md"
def feedback_text(task):
    path=feedback_path(task)
    return path.read_text(encoding="utf-8") if path.exists() else "No human feedback has been recorded."
def task_context(task):
    return "Use docs/PRODUCT.md, docs/ARCHITECTURE.md, docs/CHECKPOINTS.md and the constitution.\n\n"+task.read_text(encoding="utf-8")+"\n\n## Human feedback\n\n"+feedback_text(task)
def slug(text): return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "task"
def dependency_ids(path):
    raw=meta(path).get("depends_on","none")
    return [] if raw in ("none","") else [x.strip().upper() for x in raw.split(",") if x.strip()]
def dependency_blockers(path):
    blockers=[]
    for ident in dependency_ids(path):
        try: state=meta(find(ident)).get("status","unknown")
        except SystemExit: state="missing"
        if state!="done": blockers.append(f"{ident} ({state})")
    return blockers
def agent(requested):
    if not shutil.which("codex"): raise SystemExit("Install and authenticate Codex CLI")
    return "codex"
def create(a):
    title = a.title or input("Task title: ").strip()
    if not title: raise SystemExit("Task title is required")
    outcome = a.outcome or input("Expected outcome: ").strip()
    nums = [int(meta(p)["id"].split("-")[1]) for p in files()]
    ident = f"TASK-{max(nums, default=0)+1:03d}"
    path = BACKLOG / f"{ident}-{slug(title)}.md"
    path.write_text(f"---\nid: {ident}\ntitle: {title}\ntype: task\ncheckpoint: {a.checkpoint}\npriority: {a.priority}\nstatus: todo\ndepends_on: none\nactive_run: none\n---\n\n## Outcome\n\n{outcome or title}\n", encoding="utf-8")
    print(f"Created {ident}: {path.relative_to(ROOT)}")
def backlog(_):
    print(f"{'ID':<10} {'STATE':<9} {'CP':<4} {'PRIORITY':<9} TITLE\n" + "-"*76)
    for p in files():
        m=meta(p); state=m['status']
        if state=="todo" and not dependency_blockers(p): state="ready"
        print(f"{m['id']:<10} {state:<9} {m['checkpoint']:<4} {m['priority']:<9} {m['title']}")
def status(a):
    path=find(a.task); m=meta(path)
    for k in ("id","title","checkpoint","priority","status","depends_on","active_run"): print(f"{k}: {m.get(k,'unknown')}")
    blockers=dependency_blockers(path)
    print(f"ready: {'yes' if not blockers and m.get('status')=='todo' else 'no'}")
    if blockers: print("blocked_by: "+", ".join(blockers))
    fp=feedback_path(path)
    if fp.exists(): print(f"feedback: {fp.relative_to(ROOT)} ({fp.read_text(encoding='utf-8').count('## Feedback ')} entries)")
    run=m.get("active_run","none")
    state=read_run_state(run)
    if state:
        current=state.get("current_step_id") or "pending"
        index=int(state.get("current_step_index",0))+1
        total=len(STEP_LABELS)
        updated=state.get("updated_at","unknown")
        print(f"workflow: {state.get('status','unknown')}")
        print(f"stage: {index}/{total} {STEP_LABELS.get(current,current)}")
        print(f"last_activity: {updated}")
        print(f"log: {(SPEC_RUNS/run/'log.jsonl').relative_to(ROOT)}")
def newest_feature():
    dirs=[p for p in (ROOT/"specs").glob("[0-9][0-9][0-9]-*") if p.is_dir()]
    return max(dirs,key=lambda p:p.stat().st_mtime) if dirs else None
def git(*args, capture=True):
    return subprocess.run(["git",*args],cwd=ROOT,text=True,capture_output=capture)

def read_run_state(run):
    if run in (None,"none","unknown",""): return None
    path=SPEC_RUNS/run/"state.json"
    try: return json.loads(path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): return None

def run_ids():
    return {p.name for p in SPEC_RUNS.iterdir() if p.is_dir()} if SPEC_RUNS.exists() else set()

def latest_run():
    dirs=[p for p in SPEC_RUNS.iterdir() if p.is_dir()] if SPEC_RUNS.exists() else []
    return max(dirs,key=lambda p:p.stat().st_mtime).name if dirs else None

def process_alive(pid):
    try: os.kill(int(pid),0); return True
    except (OSError,TypeError,ValueError): return False

def recover_orphaned_run(task, run):
    """Turn a stale RUNNING state into PAUSED after proving our runner is gone."""
    state=read_run_state(run)
    if not state or state.get("status")!="running": return
    marker=RUNS/f"{meta(task)['id']}.process.json"
    try: process_data=json.loads(marker.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): process_data={}
    if process_data.get("run_id") == run and process_alive(process_data.get("pid")):
        raise SystemExit(f"Run {run} is still active in process {process_data['pid']}; use status instead of resume")
    state_path=SPEC_RUNS/run/"state.json"
    backup=SPEC_RUNS/run/"state.orphaned-running.json"
    if not backup.exists(): shutil.copy2(state_path,backup)
    state["status"]="paused"
    state["updated_at"]=datetime.now(timezone.utc).isoformat()
    state["error"]="Recovered by Agentflow after the owning process was interrupted"
    state_path.write_text(json.dumps(state,indent=2)+"\n",encoding="utf-8")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"orphaned_run_recovered","timestamp":state["updated_at"]})+"\n")
    print(f"Recovered orphaned run {run}: running → paused",flush=True)

def rewind_run(task, run, stage):
    state=read_run_state(run)
    if not state: return False
    marker=RUNS/f"{meta(task)['id']}.process.json"
    try: process_data=json.loads(marker.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): process_data={}
    if process_data.get("run_id")==run and process_alive(process_data.get("pid")):
        raise SystemExit("Cannot add feedback while the workflow is active; interrupt it with Ctrl+C first")
    recover_orphaned_run(task,run)
    state=read_run_state(run) or state
    index=STEP_ORDER.index(stage)
    stamp=datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    state_path=SPEC_RUNS/run/"state.json"
    shutil.copy2(state_path,SPEC_RUNS/run/f"state.before-feedback-{stamp}.json")
    state["status"]="paused"; state["current_step_index"]=index; state["current_step_id"]=stage
    state["step_results"]={k:v for k,v in state.get("step_results",{}).items() if k in STEP_ORDER[:index]}
    state["error"]=None; state["updated_at"]=datetime.now(timezone.utc).isoformat()
    state.setdefault("inputs",{})["spec"]=task_context(task)
    state_path.write_text(json.dumps(state,indent=2)+"\n",encoding="utf-8")
    inputs_path=SPEC_RUNS/run/"inputs.json"
    try: inputs=json.loads(inputs_path.read_text(encoding="utf-8"))
    except (OSError,json.JSONDecodeError): inputs={"inputs":{}}
    inputs.setdefault("inputs",{})["spec"]=task_context(task)
    inputs_path.write_text(json.dumps(inputs,indent=2)+"\n",encoding="utf-8")
    if WORKFLOW.exists(): shutil.copy2(WORKFLOW,SPEC_RUNS/run/"workflow.yml")
    with (SPEC_RUNS/run/"log.jsonl").open("a",encoding="utf-8") as log:
        log.write(json.dumps({"event":"feedback_rewind","stage":stage,"timestamp":state["updated_at"]})+"\n")
    return True

def add_feedback(a):
    task=find(a.task); m=meta(task); stage=STAGE_ALIASES[a.stage]
    message=a.message or input("Feedback: ").strip()
    if not message: raise SystemExit("Feedback text is required")
    run=m.get("active_run","none")
    if run not in ("none","unknown",""):
        marker=RUNS/f"{m['id']}.process.json"
        try: process_data=json.loads(marker.read_text(encoding="utf-8"))
        except (OSError,json.JSONDecodeError): process_data={}
        if process_data.get("run_id")==run and process_alive(process_data.get("pid")):
            raise SystemExit("Cannot add feedback while the workflow is active; interrupt it with Ctrl+C first")
    path=feedback_path(task); path.parent.mkdir(parents=True,exist_ok=True)
    existing=path.read_text(encoding="utf-8") if path.exists() else f"# Feedback — {m['id']}\n\n"
    count=existing.count("## Feedback ")
    if count>=MAX_FEEDBACK_CYCLES: raise SystemExit(f"Feedback limit reached ({MAX_FEEDBACK_CYCLES}); resolve or split the task before another cycle")
    stamp=datetime.now(timezone.utc).isoformat(timespec="seconds")
    author=os.environ.get("USER") or os.environ.get("USERNAME") or "human"
    entry=f"## Feedback {count+1}\n\n- Time: {stamp}\n- Author: {author}\n- Restart from: {stage}\n\n{message}\n\n"
    path.write_text(existing+entry,encoding="utf-8")
    rewound=run not in ("none","unknown","") and rewind_run(task,run,stage)
    if m.get("status")!="todo": field(task,"status","wip")
    print(f"Recorded feedback #{count+1} in {path.relative_to(ROOT)}")
    print(f"Workflow rewound to {STEP_LABELS[stage]}. Run: ./agentflow resume {m['id']}" if rewound else f"Feedback will be included when {m['id']} starts")

def history(a):
    task=find(a.task); m=meta(task)
    print(f"{m['id']} — {m['title']}\n")
    fp=feedback_path(task)
    print(fp.read_text(encoding="utf-8").rstrip() if fp.exists() else "No human feedback.")
    feature=newest_feature()
    if feature and (feature/"handoffs").exists():
        print("\n# Agent handoffs")
        for handoff in sorted((feature/"handoffs").glob("*.md")):
            print(f"\n## {handoff.stem}\n{handoff.read_text(encoding='utf-8').rstrip()}")
    run=m.get("active_run","none"); state=read_run_state(run)
    if state:
        print("\n# Workflow")
        for step in STEP_ORDER:
            result=state.get("step_results",{}).get(step)
            mark=result.get("status","pending") if result else ("current" if step==state.get("current_step_id") else "pending")
            print(f"- {step}: {mark}")

def monitor_process(cmd, task, run_hint=None):
    """Run with inherited stdin, live output, durable logs, stage updates, and heartbeat."""
    task_id=meta(task)["id"]
    RUNS.mkdir(parents=True,exist_ok=True)
    transcript=RUNS/f"{task_id}.live.log"
    before=run_ids()
    started=time.monotonic(); last_heartbeat=started; shown_step=None; run=run_hint
    print(f"Live log: {transcript.relative_to(ROOT)}",flush=True)
    child_env=os.environ.copy()
    # Spec Kit's Codex integration otherwise defaults to read-only. Current
    # Codex CLI accepts --approve-for-me on its own and selects workspace-write.
    child_env.setdefault("SPECKIT_INTEGRATION_CODEX_EXTRA_ARGS","--approve-for-me")
    process=subprocess.Popen(cmd,cwd=ROOT,stdin=None,stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,text=True,bufsize=1,env=child_env)
    marker=RUNS/f"{task_id}.process.json"
    marker.write_text(json.dumps({"pid":process.pid,"run_id":run})+"\n",encoding="utf-8")
    def pump():
        assert process.stdout is not None
        with transcript.open("a",encoding="utf-8") as log:
            log.write(f"\n[{datetime.now().isoformat(timespec='seconds')}] {' '.join(cmd)}\n")
            log.flush()
            for line in process.stdout:
                print(line,end="",flush=True); log.write(line); log.flush()
    reader=threading.Thread(target=pump,daemon=True); reader.start()
    try:
        while process.poll() is None:
            if not run:
                created=run_ids()-before
                if created:
                    run=max(created,key=lambda ident:(SPEC_RUNS/ident).stat().st_mtime)
                    field(task,"active_run",run)
                    marker.write_text(json.dumps({"pid":process.pid,"run_id":run})+"\n",encoding="utf-8")
                    print(f"Run: {run}",flush=True)
            state=read_run_state(run)
            step=state.get("current_step_id") if state else None
            if step and step != shown_step:
                shown_step=step
                index=int(state.get("current_step_index",0))+1
                print(f"\n[{task_id}] Stage {index}/{len(STEP_LABELS)}: {STEP_LABELS.get(step,step)}",flush=True)
            now=time.monotonic()
            if now-last_heartbeat >= 20:
                elapsed=int(now-started); label=STEP_LABELS.get(shown_step,shown_step or "starting")
                print(f"[{task_id}] Still active — {elapsed//60:02d}:{elapsed%60:02d} — {label}",flush=True)
                last_heartbeat=now
            time.sleep(.5)
    except KeyboardInterrupt:
        print(f"\n[{task_id}] Interrupting safely…",flush=True)
        process.send_signal(signal.SIGINT)
        try: process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            process.terminate()
            try: process.wait(timeout=5)
            except subprocess.TimeoutExpired: process.kill(); process.wait()
        reader.join(timeout=2)
        run=run or latest_run()
        if run: field(task,"active_run",run)
        marker.unlink(missing_ok=True)
        print(f"Progress preserved. Continue with: ./agentflow resume {task_id}",flush=True)
        return 130,run
    reader.join(timeout=2)
    marker.unlink(missing_ok=True)
    run=run or latest_run()
    if run: field(task,"active_run",run)
    return process.returncode,run
def publish(task, task_meta, feature):
    branch=git("branch","--show-current").stdout.strip()
    if not branch or branch in ("main","master"):
        raise RuntimeError("Refusing to publish from a protected base branch")
    field(task,"status","review")
    staged=git("add","-A")
    if staged.returncode: raise RuntimeError(staged.stderr.strip() or "git add failed")
    commit=git("commit","-m",f"Implement {task_meta['id']}: {task_meta['title']}")
    if commit.returncode: raise RuntimeError(commit.stderr.strip() or commit.stdout.strip() or "git commit failed")
    pushed=git("push","-u","origin",branch)
    if pushed.returncode: raise RuntimeError(pushed.stderr.strip() or "git push failed")
    body=RUNS/f"{task_meta['id']}-pr.md"
    body.write_text(
        f"## Agentflow delivery\n\nCloses the implementation work for `{task_meta['id']}`.\n\n"
        f"- Specification: `{feature.relative_to(ROOT)}/spec.md`\n"
        f"- Plan: `{feature.relative_to(ROOT)}/plan.md`\n"
        f"- Tasks: `{feature.relative_to(ROOT)}/tasks.md`\n"
        f"- QA: `{feature.relative_to(ROOT)}/qa-report.md` — PASS\n"
        f"- Final review: `{feature.relative_to(ROOT)}/review-report.md` — PASS\n\n"
        "The PR was created automatically after independent QA and final review. Merge remains human-controlled.\n",
        encoding="utf-8")
    pr=subprocess.run(["gh","pr","create","--base","main","--head",branch,"--title",f"{task_meta['id']}: {task_meta['title']}","--body-file",str(body)],cwd=ROOT,text=True,capture_output=True)
    if pr.returncode: raise RuntimeError(pr.stderr.strip() or "gh pr create failed")
    return pr.stdout.strip()

def finalize(task, task_meta, code, no_pr=False):
    feature=newest_feature()
    passed=bool(code==0 and feature and all((feature/n).exists() and "Verdict: PASS" in (feature/n).read_text(encoding="utf-8") for n in ("qa-report.md","review-report.md")))
    if not passed:
        field(task,"status","blocked")
        print(f"Verification failed; inspect {feature or 'specs/'} and .agentflow/runs",file=sys.stderr)
        return code or 1
    if no_pr:
        field(task,"status","review")
        print("QA and review passed. PR creation was disabled with --no-pr.")
        return 0
    try:
        url=publish(task,task_meta,feature)
        print(f"QA and review passed. Pull request created: {url}")
        return 0
    except RuntimeError as error:
        field(task,"status","blocked")
        print(f"Verification passed but PR publication failed: {error}",file=sys.stderr)
        return 1

def start(a):
    if not shutil.which("specify"): raise SystemExit("Specify CLI missing; run ./setup (macOS/Linux) or .\\setup.ps1 (Windows)")
    task=find(a.task); m=meta(task); selected=agent(a.agent)
    blockers=dependency_blockers(task)
    if blockers: raise SystemExit("Unfinished dependencies: "+", ".join(blockers))
    print(f"{m['id']} — {m['title']}\nAgent: {selected}\nFlow: product → architecture → development → QA → review → PR")
    if a.dry_run: print(f"Dry run passed; no agent invoked. PR creation: {'disabled' if a.no_pr else 'enabled'}"); return 0
    if git("status","--porcelain").stdout.strip(): raise SystemExit("Start requires a clean worktree; commit or stash existing changes")
    if git("branch","--show-current").stdout.strip() not in ("main","master"): raise SystemExit("Start from an up-to-date main branch so Spec Kit can create an isolated feature branch")
    if not a.no_pr:
        if not shutil.which("gh"): raise SystemExit("GitHub CLI is required for automatic PR creation; install gh or use --no-pr")
        auth=subprocess.run(["gh","auth","status"],cwd=ROOT,text=True,capture_output=True)
        if auth.returncode: raise SystemExit("GitHub CLI is not authenticated; run `gh auth login` or use --no-pr")
    field(task,"status","wip")
    context=task_context(task)
    cmd=["specify","workflow","run",str(WORKFLOW),"--input",f"integration={selected}","--input",f"spec={context}"]
    code,run=monitor_process(cmd,task)
    if code==130: return code
    return finalize(task,m,code,a.no_pr)
def resume(a):
    task=find(a.task); run=meta(task).get("active_run","none")
    if run in ("none","unknown",""): raise SystemExit("No resumable run; use start")
    recover_orphaned_run(task,run)
    field(task,"status","wip")
    print(f"Resuming {a.task.upper()} — run {run}")
    code,_=monitor_process(["specify","workflow","resume",run],task,run)
    if code==130: return code
    if code:
        field(task,"status","blocked")
        print(f"Resume failed. Inspect {(SPEC_RUNS/run/'state.json').relative_to(ROOT)}",file=sys.stderr)
        return code
    return finalize(task,meta(task),code)
def complete(a):
    task=find(a.task); m=meta(task)
    if m.get("status")!="review": raise SystemExit(f"Only a reviewed task can be completed; current status is {m.get('status')}")
    field(task,"status","done"); field(task,"active_run","none")
    print(f"Completed {m['id']}. Dependent tasks may now become ready.")
def verify(a):
    selected=agent(a.agent); prompt=f"Independently verify {a.task}; run checks and update qa-report.md and review-report.md without changing implementation code."
    if a.dry_run: print(f"Would verify {a.task} with {selected}"); return 0
    cmd=["codex","exec","-C",str(ROOT),"--approve-for-me","--ephemeral",prompt]
    return subprocess.run(cmd,cwd=ROOT).returncode
def menu(parser):
    while True:
        print("\nAgentflow\n1 Backlog  2 Create  3 Start  4 Status  5 Resume  6 Verify  7 Complete  8 Feedback  9 History  0 Exit")
        choice=input("> ").strip()
        if choice=="0": return 0
        argv={"1":["backlog"],"2":["create"]}.get(choice)
        if choice in "345679": argv=[{"3":"start","4":"status","5":"resume","6":"verify","7":"complete","9":"history"}[choice],input("Task id: ").strip()]
        if choice=="8": argv=["feedback",input("Task id: ").strip(),input("Feedback: ").strip()]
        if not argv: print("Invalid option"); continue
        try: x=parser.parse_args(argv); x.func(x)
        except SystemExit as e: print(e)
def parser():
    p=argparse.ArgumentParser(description="Local multi-agent SDD workflow"); s=p.add_subparsers()
    c=s.add_parser("create"); c.add_argument("title",nargs="?"); c.add_argument("--outcome"); c.add_argument("--checkpoint",choices=["CP1","CP2","CP3"],default="CP1"); c.add_argument("--priority",choices=["low","medium","high","critical"],default="medium"); c.set_defaults(func=create)
    b=s.add_parser("backlog"); b.set_defaults(func=backlog)
    q=s.add_parser("status"); q.add_argument("task"); q.set_defaults(func=status)
    for name,fn in (("start",start),("verify",verify)):
        q=s.add_parser(name); q.add_argument("task"); q.add_argument("--agent",choices=["auto","codex"],default="auto"); q.add_argument("--dry-run",action="store_true")
        if name=="start": q.add_argument("--no-pr",action="store_true",help="leave verified changes local without commit, push, or PR")
        q.set_defaults(func=fn)
    q=s.add_parser("resume"); q.add_argument("task"); q.set_defaults(func=resume)
    q=s.add_parser("complete"); q.add_argument("task"); q.set_defaults(func=complete)
    q=s.add_parser("feedback"); q.add_argument("task"); q.add_argument("message",nargs="?"); q.add_argument("--stage",choices=sorted(STAGE_ALIASES),default="development"); q.set_defaults(func=add_feedback)
    q=s.add_parser("history"); q.add_argument("task"); q.set_defaults(func=history)
    return p
if __name__=="__main__":
    p=parser()
    if len(sys.argv)==1: raise SystemExit(menu(p))
    a=p.parse_args(); raise SystemExit(a.func(a) if hasattr(a,"func") else 2)
