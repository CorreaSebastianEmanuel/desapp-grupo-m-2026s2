      "versionNonce": 226472648,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793329873206,
      "link": null,
      "locked": false,
      "text": "La cola es una tabla durable en PostgreSQL; no hay cálculo de cotización al importar estadísticas.",
      "originalText": "La cola es una tabla durable en PostgreSQL; no hay cálculo de cotización al importar estadísticas.",
