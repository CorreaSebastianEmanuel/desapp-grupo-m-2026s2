      "isDeleted": true,
      "boundElements": [],
      "updated": 1793329873206,
      "link": null,
      "locked": false,
      "text": "Cada solicitud semanal se calcula por separado; TTL usa el último alcance aceptado del jugador/temporada.",
      "originalText": "Cada solicitud semanal se calcula por separado; TTL usa el último alcance aceptado del jugador/temporada.",
