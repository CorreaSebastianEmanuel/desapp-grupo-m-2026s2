<link
  rel="stylesheet"
  href="/api-docs/swagger-ui.css"
  onerror="document.getElementById('docs-error').hidden=false"
/>
<style>
  .docs-control { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; padding: 1rem; background: #f4f6f8; }
  .docs-control input { border: 1px solid #667; padding: .4rem; }
  .docs-control select { border: 1px solid #667; padding: .4rem; }
  .swagger-ui .auth-wrapper, .swagger-ui .authorization__btn, .swagger-ui .authorize { display: none !important; }
  #docs-error { color: #a00; padding: 1rem; font-weight: bold; }
</style>
<header class="public-header docs-header">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">FM</span> Football Market</a><a
    class="text-link"
    href="/portfolio"
  >Espacio de trabajo →</a>
</header>
<main>
  <h1 style="padding: 1rem">Documentación de la API de Football Market CP1</h1>
  <div class="docs-control">
    <label for="credential-mode">Método de autenticación</label>
    <select id="credential-mode" aria-label="Método de autenticación">
      <option value="jwt">Bearer JWT</option>
      <option value="api_key">API key</option>
    </select>
    <label for="credential-value">Credencial</label>
    <input
      id="credential-value"
      type="password"
      autocomplete="off"
      spellcheck="false"
      aria-label="Credencial"
    />
    <span>Usá una credencial por vez. Al cambiar el método se borra el valor ingresado.</span>
  </div>
  <p id="docs-error" role="alert" hidden>
    No se pudo cargar la documentación de la API. Revisá los recursos locales y el contrato.
  </p>
  <div id="swagger-ui"></div>
</main>
<script
  src="/api-docs/swagger-ui-bundle.js"
  onerror="document.getElementById('docs-error').hidden=false"
>
</script>
<script src="/api-docs/docs.js" onerror="document.getElementById('docs-error').hidden=false">
</script>
