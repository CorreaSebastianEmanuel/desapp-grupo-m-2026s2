<div class="auth-page">
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">FM</span> Football Market</a>
  <main class="workspace-form">
    <p class="eyebrow">TU ESPACIO DE TRABAJO</p>
    <h1>Crear cuenta</h1>
    <p class="muted">Guardá tu portafolio y administrá tus órdenes en un solo lugar.</p>
    <p :if={@message} id="registration-message" role="alert">{@message}</p>
    <form method="post" action="/register">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
      <label for="email">Correo electrónico</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        value={@email}
        aria-invalid={to_string(@invalid)}
        aria-describedby={@invalid && "registration-message"}
      />
      <label for="password">Contraseña</label>
      <input
        id="password"
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="12"
        maxlength="128"
        required
        aria-invalid={to_string(@invalid)}
        aria-describedby="password-guidance"
      />
      <p id="password-guidance" class="auth-note">Usá entre 12 y 128 caracteres.</p>
      <label for="password-confirmation">Confirmar contraseña</label>
      <input
        id="password-confirmation"
        name="password_confirmation"
        type="password"
        autocomplete="new-password"
        minlength="12"
        maxlength="128"
        required
        aria-invalid={to_string(@invalid)}
        aria-describedby={@invalid && "registration-message"}
      />
      <button type="submit">Crear cuenta</button>
    </form>
    <p class="auth-note">¿Ya tenés cuenta? <a href="/sign-in">Iniciar sesión</a>.</p>
  </main>
  <a class="text-link" href="/">← Volver a Football Market</a>
</div>
