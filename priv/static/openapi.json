{
  "openapi": "3.0.3",
  "info": {
    "title": "Football Market CP1 Catalog API",
    "version": "1.0.0",
    "description": "Existing protected CP1 catalog HTTP contract. Account registration, login and key issuance are not public HTTP operations. Use one reader-supplied credential in the interactive page."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/players": {
      "get": {
        "summary": "List players",
        "description": "Locally stored players only; no live provider fetch. Ordered by case-insensitive display name, then stable player ID. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid. Opaque continuation token: do not decode or manufacture it. It is bound to the effective filter set. Equivalent UUID letter case and query-key order preserve that set; changing only page_size is allowed. Adding, removing or changing a filter with a cursor yields invalid_cursor. Traversal is not a snapshot. For authenticated invalid input, error priority is page_size, league_id, team_id, position_id, cursor. Supply exactly one credential. Authorization header names and the Bearer scheme are case-insensitive; credential values are exact. Missing, invalid, expired, repeated or mixed credentials return the same generic 401. Authentication runs before parameter validation or catalog access.",
        "operationId": "listPlayers",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Omitted defaults to 25. Explicit value is one unsigned base-10 integer from 1 through 100. Blank, malformed, structured or repeated values yield invalid_page_size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "example": 25
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation token: do not decode or manufacture it. It is bound to the effective filter set. Equivalent UUID letter case and query-key order preserve that set; changing only page_size is allowed. Adding, removing or changing a filter with a cursor yields invalid_cursor. Traversal is not a snapshot. One non-empty value only; blank, malformed, structured or repeated values yield invalid_cursor.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "league_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player league identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player team identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player position identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exactly data and pagination. data length never exceeds applied page_size. returned_count equals data length; has_more indicates another matching player follows; next_cursor is non-empty exactly when has_more is true, otherwise null. Empty pages retain all pagination fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerPage"
                },
                "examples": {
                  "populated": {
                    "value": {
                      "data": [
                        {
                          "id": "11111111-1111-4111-8111-111111111111",
                          "display_name": "Mara Calder",
                          "catalog_identity": "sample-player-001",
                          "position": {
                            "id": "22222222-2222-4222-8222-222222222222",
                            "code": "FW",
                            "name": "Forward"
                          },
                          "team": {
                            "id": "33333333-3333-4333-8333-333333333333",
                            "short_code": "NBR",
                            "name": "Northbridge FC"
                          },
                          "season": {
                            "id": "44444444-4444-4444-8444-444444444444",
                            "start_year": 2025,
                            "end_year": 2026
                          },
                          "league": {
                            "id": "55555555-5555-4555-8555-555555555555",
                            "code": "PL",
                            "name": "Premier League"
                          }
                        }
                      ],
                      "pagination": {
                        "page_size": 25,
                        "returned_count": 1,
                        "has_more": false,
                        "next_cursor": null
                      }
                    }
                  },
                  "empty": {
                    "value": {
                      "data": [],
                      "pagination": {
                        "page_size": 25,
                        "returned_count": 0,
                        "has_more": false,
                        "next_cursor": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "One error code. For multiple invalid values, priority is page_size, league_id, team_id, position_id, cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListInputError"
                },
                "examples": {
                  "invalid_page_size": {
                    "value": {
                      "error": {
                        "code": "invalid_page_size"
                      }
                    }
                  },
                  "invalid_league_id": {
                    "value": {
                      "error": {
                        "code": "invalid_league_id"
                      }
                    }
                  },
                  "invalid_team_id": {
                    "value": {
                      "error": {
                        "code": "invalid_team_id"
                      }
                    }
                  },
                  "invalid_position_id": {
                    "value": {
                      "error": {
                        "code": "invalid_position_id"
                      }
                    }
                  },
                  "invalid_cursor": {
                    "value": {
                      "error": {
                        "code": "invalid_cursor"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          }
        }
      }
    },
    "/api/players/{player_id}": {
      "get": {
        "summary": "Get player by ID",
        "description": "Look up the stable player UUID. Malformed or unknown IDs both yield player_not_found. Supply exactly one credential. Authorization header names and the Bearer scheme are case-insensitive; credential values are exact. Missing, invalid, expired, repeated or mixed credentials return the same generic 401. Authentication runs before parameter validation or catalog access.",
        "operationId": "getPlayer",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "description": "Stable player UUID; malformed and absent identities yield the same 404.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "200": {
            "description": "Exactly one data player.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerDetail"
                },
                "examples": {
                  "player": {
                    "value": {
                      "data": {
                        "id": "11111111-1111-4111-8111-111111111111",
                        "display_name": "Mara Calder",
                        "catalog_identity": "sample-player-001",
                        "position": {
                          "id": "22222222-2222-4222-8222-222222222222",
                          "code": "FW",
                          "name": "Forward"
                        },
                        "team": {
                          "id": "33333333-3333-4333-8333-333333333333",
                          "short_code": "NBR",
                          "name": "Northbridge FC"
                        },
                        "season": {
                          "id": "44444444-4444-4444-8444-444444444444",
                          "start_year": 2025,
                          "end_year": 2026
                        },
                        "league": {
                          "id": "55555555-5555-4555-8555-555555555555",
                          "code": "PL",
                          "name": "Premier League"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          },
          "404": {
            "description": "Malformed or unknown player identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerNotFoundError"
                },
                "examples": {
                  "player_not_found": {
                    "value": {
                      "error": {
                        "code": "player_not_found"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authorization: Bearer <JWT>. Supply only this method when selected. Header and scheme case-insensitive; token value exact."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "X-API-Key: <key>. Supply only this method when selected. Header name case-insensitive; key value exact."
      }
    },
    "schemas": {
      "Position": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Team": {
        "type": "object",
        "required": [
          "id",
          "short_code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "short_code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Season": {
        "type": "object",
        "required": [
          "id",
          "start_year",
          "end_year"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "start_year": {
            "type": "integer"
          },
          "end_year": {
            "type": "integer"
          }
        }
      },
      "League": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Player": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "catalog_identity",
          "position",
          "team",
          "season",
          "league"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "catalog_identity": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "team": {
            "$ref": "#/components/schemas/Team"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "league": {
            "$ref": "#/components/schemas/League"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page_size",
          "returned_count",
          "has_more",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "returned_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "nullable": true,
            "description": "Non-empty when has_more is true; null otherwise."
          }
        }
      },
      "PlayerPage": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "description": "At most the applied page_size players."
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "PlayerDetail": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Player"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorValue"
          }
        }
      },
      "ErrorValue": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "invalid_page_size",
              "invalid_league_id",
              "invalid_team_id",
              "invalid_position_id",
              "invalid_cursor",
              "player_not_found"
            ]
          }
        }
      },
      "UnauthenticatedError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated"
                ]
              }
            }
          }
        }
      },
      "ListInputError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_page_size",
                  "invalid_league_id",
                  "invalid_team_id",
                  "invalid_position_id",
                  "invalid_cursor"
                ]
              }
            }
          }
        }
      },
      "PlayerNotFoundError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "player_not_found"
                ]
              }
            }
          }
        }
      }
    }
  }
}
