{
  "openapi": "3.0.3",
  "info": {
    "title": "Football Market Catalog and Quote API",
    "version": "1.1.0",
    "description": "Protected local catalog and immutable quote read APIs. Account registration, login and key issuance are not public HTTP operations. Use one reader-supplied credential in the interactive page."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/players": {
      "get": {
        "summary": "List players",
        "description": "Locally stored players only; no live provider fetch. Ordered by case-insensitive display name, then stable player ID. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid. Opaque continuation token: do not decode or manufacture it. It is bound to the effective filter set. Equivalent UUID letter case and query-key order preserve that set; changing only page_size is allowed. Adding, removing or changing a filter with a cursor yields invalid_cursor. Traversal is not a snapshot. For authenticated invalid input, error priority is page_size, league_id, team_id, position_id, cursor. Supply exactly one credential. Authorization header names and the Bearer scheme are case-insensitive; credential values are exact. Missing, invalid, expired, repeated or mixed credentials return the same generic 401. Authentication runs before parameter validation or catalog access.",
        "operationId": "listPlayers",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "description": "Omitted defaults to 25. Explicit value is one unsigned base-10 integer from 1 through 100. Blank, malformed, structured or repeated values yield invalid_page_size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "example": 25
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque continuation token: do not decode or manufacture it. It is bound to the effective filter set. Equivalent UUID letter case and query-key order preserve that set; changing only page_size is allowed. Adding, removing or changing a filter with a cursor yields invalid_cursor. Traversal is not a snapshot. One non-empty value only; blank, malformed, structured or repeated values yield invalid_cursor.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "league_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player league identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          },
          {
            "name": "team_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player team identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          },
          {
            "name": "position_id",
            "in": "query",
            "required": false,
            "description": "One UUID without surrounding whitespace matching the player position identity. Filters intersect by matching the corresponding nested player id. Omitted filters do not restrict results. Valid unknown or conflicting UUIDs return an empty 200 page. Unknown query keys are ignored and query-key order has no effect. Each supported parameter must occur once; blank, malformed, structured and repeated values are invalid.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exactly data and pagination. data length never exceeds applied page_size. returned_count equals data length; has_more indicates another matching player follows; next_cursor is non-empty exactly when has_more is true, otherwise null. Empty pages retain all pagination fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerPage"
                },
                "examples": {
                  "populated": {
                    "value": {
                      "data": [
                        {
                          "id": "11111111-1111-4111-8111-111111111111",
                          "display_name": "Mara Calder",
                          "catalog_identity": "sample-player-001",
                          "position": {
                            "id": "22222222-2222-4222-8222-222222222222",
                            "code": "FW",
                            "name": "Forward"
                          },
                          "team": {
                            "id": "33333333-3333-4333-8333-333333333333",
                            "short_code": "NBR",
                            "name": "Northbridge FC"
                          },
                          "season": {
                            "id": "44444444-4444-4444-8444-444444444444",
                            "start_year": 2025,
                            "end_year": 2026
                          },
                          "league": {
                            "id": "55555555-5555-4555-8555-555555555555",
                            "code": "PL",
                            "name": "Premier League"
                          }
                        }
                      ],
                      "pagination": {
                        "page_size": 25,
                        "returned_count": 1,
                        "has_more": false,
                        "next_cursor": null
                      }
                    }
                  },
                  "empty": {
                    "value": {
                      "data": [],
                      "pagination": {
                        "page_size": 25,
                        "returned_count": 0,
                        "has_more": false,
                        "next_cursor": null
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "One error code. For multiple invalid values, priority is page_size, league_id, team_id, position_id, cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListInputError"
                },
                "examples": {
                  "invalid_page_size": {
                    "value": {
                      "error": {
                        "code": "invalid_page_size"
                      }
                    }
                  },
                  "invalid_league_id": {
                    "value": {
                      "error": {
                        "code": "invalid_league_id"
                      }
                    }
                  },
                  "invalid_team_id": {
                    "value": {
                      "error": {
                        "code": "invalid_team_id"
                      }
                    }
                  },
                  "invalid_position_id": {
                    "value": {
                      "error": {
                        "code": "invalid_position_id"
                      }
                    }
                  },
                  "invalid_cursor": {
                    "value": {
                      "error": {
                        "code": "invalid_cursor"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          }
        }
      }
    },
    "/api/players/{player_id}": {
      "get": {
        "summary": "Get player by ID",
        "description": "Look up the stable player UUID. Malformed or unknown IDs both yield player_not_found. Supply exactly one credential. Authorization header names and the Bearer scheme are case-insensitive; credential values are exact. Missing, invalid, expired, repeated or mixed credentials return the same generic 401. Authentication runs before parameter validation or catalog access.",
        "operationId": "getPlayer",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "description": "Stable player UUID; malformed and absent identities yield the same 404.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "200": {
            "description": "Exactly one data player.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerDetail"
                },
                "examples": {
                  "player": {
                    "value": {
                      "data": {
                        "id": "11111111-1111-4111-8111-111111111111",
                        "display_name": "Mara Calder",
                        "catalog_identity": "sample-player-001",
                        "position": {
                          "id": "22222222-2222-4222-8222-222222222222",
                          "code": "FW",
                          "name": "Forward"
                        },
                        "team": {
                          "id": "33333333-3333-4333-8333-333333333333",
                          "short_code": "NBR",
                          "name": "Northbridge FC"
                        },
                        "season": {
                          "id": "44444444-4444-4444-8444-444444444444",
                          "start_year": 2025,
                          "end_year": 2026
                        },
                        "league": {
                          "id": "55555555-5555-4555-8555-555555555555",
                          "code": "PL",
                          "name": "Premier League"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          },
          "404": {
            "description": "Malformed or unknown player identity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerNotFoundError"
                },
                "examples": {
                  "player_not_found": {
                    "value": {
                      "error": {
                        "code": "player_not_found"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/players/{player_id}/quotes/current": {
      "get": {
        "summary": "Get current player quote",
        "description": "Local committed quotes only. No provider calls or calculations. Supply exactly one credential. Authentication runs before date validation and player lookup. Malformed and unknown player IDs return player_not_found. Sequence (initial issuance = 0) is authoritative, with effective_at, inserted_at and id as descending tie-breakers for single selection. Prices are exact two-place decimal strings; timestamps are UTC. Initial issuance has null calculation, configuration, mapping and sequence metadata. Unknown query keys are ignored. Returns the highest persisted quote sequence. Existing players without quotes return quote_not_found.",
        "operationId": "getCurrentQuote",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "description": "Stable player UUID; malformed and absent identities yield the same 404.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted immutable quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteDetail"
                },
                "examples": {
                  "issuance": {
                    "value": {
                      "data": {
                        "id": "c06ed3cb-c408-4f3d-9a66-0315d28d263a",
                        "player_id": "46da2ccd-86af-420f-9060-3165f6282967",
                        "unit_price": "1.00",
                        "effective_at": "2026-10-25T12:00:00.000000Z",
                        "inserted_at": "2026-10-25T12:00:00.000000Z",
                        "rule_id": "initial_issuance",
                        "rule_version": "1",
                        "calculation_id": null,
                        "configuration_version_id": null,
                        "mapping_id": null,
                        "performance_sequence": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          },
          "404": {
            "description": "Unknown player, or no eligible single quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteNotFoundError"
                },
                "examples": {
                  "player_not_found": {
                    "value": {
                      "error": {
                        "code": "player_not_found"
                      }
                    }
                  },
                  "quote_not_found": {
                    "value": {
                      "error": {
                        "code": "quote_not_found"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Local quote storage is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteUnavailableError"
                },
                "examples": {
                  "unavailable": {
                    "value": {
                      "error": {
                        "code": "temporarily_unavailable"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/players/{player_id}/quotes/history": {
      "get": {
        "summary": "Get full player quote history",
        "description": "Local committed quotes only. No provider calls or calculations. Supply exactly one credential. Authentication runs before date validation and player lookup. Malformed and unknown player IDs return player_not_found. Sequence (initial issuance = 0) is authoritative, with effective_at, inserted_at and id as descending tie-breakers for single selection. Prices are exact two-place decimal strings; timestamps are UTC. Initial issuance has null calculation, configuration, mapping and sequence metadata. Unknown query keys are ignored. Returns every quote, including equal-price calculations and initial issuance, ordered ascending by sequence (initial issuance = 0), inserted_at and id. No pagination or truncation. Existing players without quotes return an empty data array.",
        "operationId": "getQuoteHistory",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "description": "Stable player UUID; malformed and absent identities yield the same 404.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "responses": {
          "200": {
            "description": "Full immutable quote history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteHistory"
                },
                "examples": {
                  "issuance": {
                    "value": {
                      "data": [
                        {
                          "id": "c06ed3cb-c408-4f3d-9a66-0315d28d263a",
                          "player_id": "46da2ccd-86af-420f-9060-3165f6282967",
                          "unit_price": "1.00",
                          "effective_at": "2026-10-25T12:00:00.000000Z",
                          "inserted_at": "2026-10-25T12:00:00.000000Z",
                          "rule_id": "initial_issuance",
                          "rule_version": "1",
                          "calculation_id": null,
                          "configuration_version_id": null,
                          "mapping_id": null,
                          "performance_sequence": null
                        }
                      ]
                    }
                  },
                  "empty": {
                    "value": {
                      "data": []
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          },
          "404": {
            "description": "Unknown player, or no eligible single quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteNotFoundError"
                },
                "examples": {
                  "player_not_found": {
                    "value": {
                      "error": {
                        "code": "player_not_found"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Local quote storage is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteUnavailableError"
                },
                "examples": {
                  "unavailable": {
                    "value": {
                      "error": {
                        "code": "temporarily_unavailable"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/players/{player_id}/quotes/at": {
      "get": {
        "summary": "Get player quote at a UTC date",
        "description": "Local committed quotes only. No provider calls or calculations. Supply exactly one credential. Authentication runs before date validation and player lookup. Malformed and unknown player IDs return player_not_found. Sequence (initial issuance = 0) is authoritative, with effective_at, inserted_at and id as descending tie-breakers for single selection. Prices are exact two-place decimal strings; timestamps are UTC. Initial issuance has null calculation, configuration, mapping and sequence metadata. Unknown query keys are ignored. Requires one exact YYYY-MM-DD date. Returns the last eligible sequence effective through 23:59:59.999999 UTC that date, carrying forward through gaps. Dates before issuance return quote_not_found; future dates return the latest eligible stored quote. Missing, blank, structured, repeated or invalid dates yield invalid_date before player lookup. The quote retains its original effective_at.",
        "operationId": "getQuoteAtDate",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "path",
            "required": true,
            "description": "Stable player UUID; malformed and absent identities yield the same 404.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "One exact ISO calendar date in UTC. Latest quote on or before the end of this day.",
            "schema": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "example": "2026-10-25"
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted immutable quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteDetail"
                },
                "examples": {
                  "issuance": {
                    "value": {
                      "data": {
                        "id": "c06ed3cb-c408-4f3d-9a66-0315d28d263a",
                        "player_id": "46da2ccd-86af-420f-9060-3165f6282967",
                        "unit_price": "1.00",
                        "effective_at": "2026-10-25T12:00:00.000000Z",
                        "inserted_at": "2026-10-25T12:00:00.000000Z",
                        "rule_id": "initial_issuance",
                        "rule_version": "1",
                        "calculation_id": null,
                        "configuration_version_id": null,
                        "mapping_id": null,
                        "performance_sequence": null
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No usable credential; authentication precedes validation and catalog access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthenticatedError"
                },
                "examples": {
                  "unauthenticated": {
                    "value": {
                      "error": {
                        "code": "unauthenticated"
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string",
                  "enum": [
                    "Bearer realm=\"api\""
                  ]
                },
                "example": "Bearer realm=\"api\""
              }
            }
          },
          "404": {
            "description": "Unknown player, or no eligible single quote.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteNotFoundError"
                },
                "examples": {
                  "player_not_found": {
                    "value": {
                      "error": {
                        "code": "player_not_found"
                      }
                    }
                  },
                  "quote_not_found": {
                    "value": {
                      "error": {
                        "code": "quote_not_found"
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Local quote storage is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteUnavailableError"
                },
                "examples": {
                  "unavailable": {
                    "value": {
                      "error": {
                        "code": "temporarily_unavailable"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or ambiguous date input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteDateError"
                },
                "examples": {
                  "invalid_date": {
                    "value": {
                      "error": {
                        "code": "invalid_date"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authorization: Bearer <JWT>. Supply only this method when selected. Header and scheme case-insensitive; token value exact."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "X-API-Key: <key>. Supply only this method when selected. Header name case-insensitive; key value exact."
      }
    },
    "schemas": {
      "Position": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Team": {
        "type": "object",
        "required": [
          "id",
          "short_code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "short_code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Season": {
        "type": "object",
        "required": [
          "id",
          "start_year",
          "end_year"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "start_year": {
            "type": "integer"
          },
          "end_year": {
            "type": "integer"
          }
        }
      },
      "League": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Player": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "catalog_identity",
          "position",
          "team",
          "season",
          "league"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "catalog_identity": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "team": {
            "$ref": "#/components/schemas/Team"
          },
          "season": {
            "$ref": "#/components/schemas/Season"
          },
          "league": {
            "$ref": "#/components/schemas/League"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page_size",
          "returned_count",
          "has_more",
          "next_cursor"
        ],
        "additionalProperties": false,
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "returned_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "minLength": 1,
            "nullable": true,
            "description": "Non-empty when has_more is true; null otherwise."
          }
        }
      },
      "PlayerPage": {
        "type": "object",
        "required": [
          "data",
          "pagination"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            },
            "description": "At most the applied page_size players."
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "PlayerDetail": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Player"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorValue"
          }
        }
      },
      "ErrorValue": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "invalid_page_size",
              "invalid_league_id",
              "invalid_team_id",
              "invalid_position_id",
              "invalid_cursor",
              "player_not_found"
            ]
          }
        }
      },
      "UnauthenticatedError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unauthenticated"
                ]
              }
            }
          }
        }
      },
      "ListInputError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_page_size",
                  "invalid_league_id",
                  "invalid_team_id",
                  "invalid_position_id",
                  "invalid_cursor"
                ]
              }
            }
          }
        }
      },
      "PlayerNotFoundError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "player_not_found"
                ]
              }
            }
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "id",
          "player_id",
          "unit_price",
          "effective_at",
          "inserted_at",
          "rule_id",
          "rule_version",
          "calculation_id",
          "configuration_version_id",
          "mapping_id",
          "performance_sequence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "minLength": 1
          },
          "player_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 1
          },
          "unit_price": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$",
            "description": "Exact positive decimal credits per token; never a JSON number."
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          },
          "inserted_at": {
            "type": "string",
            "format": "date-time"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_version": {
            "type": "string",
            "minLength": 1
          },
          "calculation_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "configuration_version_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "mapping_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "performance_sequence": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          }
        }
      },
      "QuoteDetail": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Quote"
          }
        }
      },
      "QuoteHistory": {
        "type": "object",
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Quote"
            }
          }
        }
      },
      "QuoteNotFoundError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "player_not_found",
                  "quote_not_found"
                ]
              }
            }
          }
        }
      },
      "QuoteDateError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_date"
                ]
              }
            }
          }
        }
      },
      "QuoteUnavailableError": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "temporarily_unavailable"
                ]
              }
            }
          }
        }
      }
    }
  }
}
