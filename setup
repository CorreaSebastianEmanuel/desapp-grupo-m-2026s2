#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v uv >/dev/null 2>&1 || { echo "Install uv: https://docs.astral.sh/uv/getting-started/installation/" >&2; exit 1; }
command -v specify >/dev/null 2>&1 || uv tool install specify-cli
if ! command -v codex >/dev/null 2>&1 && ! command -v claude >/dev/null 2>&1; then
  echo "Install and authenticate Codex CLI or Claude Code." >&2; exit 1
fi
command -v gh >/dev/null 2>&1 || { echo "GitHub CLI is required for automatic PR creation: https://cli.github.com/" >&2; exit 1; }
cd "$ROOT"
specify integration status
./agentflow start TASK-001 --dry-run
echo "Ready. Run ./agentflow or ./agentflow backlog."
