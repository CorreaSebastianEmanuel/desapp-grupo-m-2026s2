{
  "schema_version": 1,
  "runtime_required": true,
  "checks": [
    {
      "id": "preflight",
      "argv": [
        "mix",
        "infrastructure.verify"
      ],
      "env": {
        "MIX_ENV": "test"
      },
      "reuse": false
    },
    {
      "id": "format",
      "argv": [
        "mix",
        "format",
        "--check-formatted"
      ],
      "env": {
        "MIX_ENV": "test"
      }
    },
    {
      "id": "compile",
      "argv": [
        "mix",
        "compile",
        "--warnings-as-errors"
      ],
      "env": {
        "MIX_ENV": "test"
      }
    },
    {
      "id": "quote-regressions",
      "argv": [
        "mix",
        "test",
        "--warnings-as-errors",
        "test/football_market/quotes/admission_test.exs",
        "test/football_market/quotes/import_test.exs",
        "test/football_market/quotes/recovery_test.exs",
        "test/football_market/quotes/followup_test.exs",
        "test/football_market/quotes/immutability_test.exs",
        "test/football_market/quotes/outcomes_test.exs",
        "test/football_market/quotes/replay_test.exs"
      ],
      "env": {
        "MIX_ENV": "test"
      }
    },
    {
      "id": "unit",
      "argv": [
        "sh",
        "scripts/test_profile.sh",
        "unit"
      ],
      "env": {
        "MIX_ENV": "test"
      }
    },
    {
      "id": "integration",
      "argv": [
        "sh",
        "scripts/test_profile.sh",
        "integration"
      ],
      "env": {
        "MIX_ENV": "test"
      }
    },
    {
      "id": "runtime",
      "argv": [
        "sh",
        "-c",
        "mix infrastructure.verify && mix run scripts/verify_quote_runtime.exs"
      ],
      "env": {
        "MIX_ENV": "test"
      },
      "runtime": true,
      "reuse": false,
      "expectation": "Fail if PostgreSQL migration probe or Redis PONG readiness fails; fresh BEAM processes assert persisted original replay, import-commit recovery, initial issuance preserved, total holdings 100, exact quote price/configuration/mapping/membership, one pending quote-keyed evaluation, lost-ack duplicate suppression, and safe independent statuses. No HTTP endpoints are affected."
    }
  ],
  "coverage": {
    "FR-001": [
      "integration"
    ],
    "FR-002": [
      "integration"
    ],
    "FR-003": [
      "unit",
      "integration"
    ],
    "FR-004": [
      "unit",
      "integration",
      "runtime",
      "quote-regressions"
    ],
    "FR-005": [
      "integration"
    ],
