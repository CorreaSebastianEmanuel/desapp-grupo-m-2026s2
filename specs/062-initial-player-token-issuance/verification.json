    {
      "id": "committed_scope_regression",
      "argv": [
        "python3",
        "-c",
        "from pathlib import Path\nimport hashlib, subprocess, tempfile\nroot = Path.cwd()\ndef run(args, cwd=root):\n    return subprocess.run(args, cwd=cwd, check=True, text=True, capture_output=True).stdout\nwith tempfile.TemporaryDirectory(prefix=\"market-committed-scope-\") as directory:\n    checkout = Path(directory) / \"checkout\"\n    run([\"git\", \"clone\", \"--quiet\", \"--no-local\", \"--depth\", \"1\", \"--single-branch\", str(root), str(checkout)])\n    assert run([\"git\", \"rev-parse\", \"--is-shallow-repository\"], checkout).strip() == \"true\"\n    assert run([\"git\", \"rev-list\", \"--count\", \"HEAD\"], checkout).strip() == \"1\"\n    assert run([\"git\", \"status\", \"--porcelain\"], checkout) == \"\"\n    config = (checkout / \"config/config.exs\").read_bytes()\n    assert hashlib.sha256(config).hexdigest() == \"b2f9904816f5efed3b630e782e7519058f96b18dc8b5d101dcbeb81ec8577251\"\n    assert config == (root / \"config/config.exs\").read_bytes()\n    scope = \"test/football_market/market/scope_test.exs\"\n    (checkout / scope).write_bytes((root / scope).read_bytes())\n    changes = run([\"git\", \"status\", \"--porcelain\", \"--untracked-files=all\"], checkout).splitlines()\n    assert all(line[3:] == scope for line in changes), changes\n    for name in [\"deps\", \"_build\"]:\n        (checkout / name).symlink_to(root / name, target_is_directory=True)\n    print(\"COMMITTED_SCOPE shallow=true commits=1 approved_config=committed correction=scope_test_only\", flush=True)\n    subprocess.run([\"mix\", \"test\", scope, \"--warnings-as-errors\"], cwd=checkout, check=True)\n"
      ],
      "env": {
        "MIX_ENV": "test"
      },
      "reuse": false
    },
    {
