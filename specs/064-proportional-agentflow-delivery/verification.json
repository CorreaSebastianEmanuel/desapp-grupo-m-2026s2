{
  "schema_version": 1,
  "runtime_required": false,
  "runtime_rationale": "Workflow CLI/JSON and policy changes only; no affected HTTP endpoint. Existing application API/OpenAPI regression commands remain required. Service preflight is an independent executable obligation.",
  "checks": [
    {
      "id": "preflight",
      "argv": [
        "python3",
        "scripts/agentflow_ci_check.py",
        "preflight"
      ],
      "reuse": false,
      "expectation": "Assert exact BEAM/Node and pinned required service versions, PostgreSQL/Redis readiness, locked dependencies/browser availability and current CI applicability; failure blocks QA. No model calls.",
      "retry_inputs": [
        ".github/workflows/*.yml",
        "compose.yaml",
        "mix.lock",
        "tools/openapi/package-lock.json",
        "scripts/agentflow_ci_check.py",
        "scripts/check_toolchain.sh",
        "scripts/local_services.sh"
      ]
    },
    {
      "id": "script-syntax",
      "argv": [
        "python3",
        "-c",
        "import pathlib,subprocess; files=[pathlib.Path('agentflow'),*pathlib.Path('scripts').glob('*.py'),*pathlib.Path('test/scripts').rglob('*.py')]; assert files; [compile(p.read_bytes(),str(p),'exec') for p in files]; shells=[*pathlib.Path('.specify/scripts/bash').glob('*.sh'),pathlib.Path('scripts/ci_unit_tests.sh'),pathlib.Path('test/scripts/ci_unit_tests_test.sh')]; [subprocess.run(['bash','-n',str(p)],check=True) for p in shells]; print('Python and shell syntax checked:',len(files)+len(shells))"
      ],
      "expectation": "Compile every delivery Python source and behavior test; parse each affected shell script individually, propagating syntax errors.",
      "retry_inputs": [
        "agentflow",
        "scripts/*.py",
        "test/scripts/**/*.py",
        ".specify/scripts/bash/*.sh",
        "scripts/ci_unit_tests.sh",
        "test/scripts/ci_unit_tests_test.sh"
      ]
    },
    {
      "id": "workflow-tests",
      "argv": [
        "python3",
        "-c",
        "import pathlib,sys,unittest; required=['agentflow_policy_test.py', 'agentflow_ci_check_test.py', 'agentflow_clean_checkout_test.py', 'agentflow_artifacts_test.py', 'agentflow_evidence_test.py', 'agentflow_feedback_test.py', 'agentflow_models_test.py', 'agentflow_metrics_test.py']; assert all((pathlib.Path('test/scripts')/p).is_file() for p in required),'Missing required acceptance module'; assert all(unittest.defaultTestLoader.loadTestsFromName('test.scripts.'+p[:-3]).countTestCases()>0 for p in required),'Required acceptance module is empty'; suite=unittest.defaultTestLoader.discover('test/scripts',pattern='*_test.py',top_level_dir='.'); count=suite.countTestCases(); assert count>0,'Required workflow collection is empty'; result=unittest.TextTestRunner(verbosity=1).run(suite); assert not result.skipped,'Required workflow checks were skipped'; print('workflow discovery count:',count); sys.exit(0 if result.wasSuccessful() else 1)"
      ],
      "expectation": "Execute all existing and new *_test.py behavior suites; nonzero discovery and no skipped required cases; cover every numbered story scenario through the modules listed in acceptance_tests. Include deterministic actual launch-argument capture for all stage defaults, explicit overrides/precedence, unsupported and unavailable selections, saved/legacy/frozen resumes, provenance and independent gates; no live model calls.",
      "retry_inputs": [
        "agentflow",
        "scripts/*.py",
        "test/scripts/**",
        ".agents/skills/**",
        ".agentflow/workflow.yml",
        ".specify/workflows/*/workflow.yml",
        ".specify/scripts/bash/**",
        ".specify/templates/**",
        "docs/AGENT*.md",
        "docs/PRODUCT.md",
        "docs/CHECKPOINTS.md",
        "docs/ARCHITECTURE.md",
        "docs/adr/0026-proportional-delivery-and-local-evidence.md",
        ".github/workflows/**",
        ".gitignore",
        ".agentflow/models.json",
        "docs/AGENTFLOW_MODELS.md",
        "docs/adr/0027-stable-stage-model-assignments.md"
      ]
    },
    {
      "id": "shell-discovery",
      "argv": [
        "sh",
        "test/scripts/ci_unit_tests_test.sh"
      ],
      "expectation": "Assert exact CI command, nonzero discovered tests, sentinel enforcement and child failures using deterministic fake toolchain fixtures.",
      "retry_inputs": [
        "scripts/ci_unit_tests.sh",
        "test/scripts/ci_unit_tests_test.sh"
      ]
    },
    {
      "id": "format",
      "argv": [
        "mix",
        "format",
        "--check-formatted"
      ],
      "retry_inputs": [
        ".formatter.exs",
        "mix.exs",
