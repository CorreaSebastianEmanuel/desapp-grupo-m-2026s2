      "id": "inventory",
      "argv": [
        "mix",
        "run",
        "--no-start",
        "-e",
        "{:ok, _} = Application.ensure_all_started(:credo)\nexec = Credo.run([\"--format\", \"flycheck\"])\nfalse = exec.strict\n0 = exec.min_priority\nsources = Credo.Execution.get_source_files(exec)\ntrue = Enum.all?(sources, &(&1.status == :valid))\ninputs = sources |> Enum.map(& &1.filename) |> Enum.sort()\n{listed, 0} = System.cmd(\"git\", [\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"-z\"])\nmaintained = listed |> String.split(<<0>>, trim: true) |> Enum.uniq() |> Enum.filter(fn path ->\n  (String.starts_with?(path, [\"lib/\", \"test/\", \"priv/\", \"config/\", \"scripts/\"]) or Path.dirname(path) == \".\") and Path.extname(path) in [\".ex\", \".exs\"] and File.regular?(path)\nend) |> Enum.sort()\n[] = maintained -- inputs\nissues = Credo.Execution.get_issues(exec) |> Enum.filter(&(&1.priority >= 0))\nrows = Enum.map(issues, fn issue -> %{check: inspect(issue.check), path: issue.filename, line: issue.line_no, column: issue.column, category: issue.category, message: issue.message} end)\nhashes = Map.new(inputs, fn path -> {path, Base.encode16(:crypto.hash(:sha256, File.read!(path)), case: :lower)} end)\nFile.mkdir_p!(\"tmp/task066\")\nFile.write!(\"tmp/task066/effective-measurement.json\", Jason.encode!(%{version: Credo.version(), command: \"MIX_ENV=test mix credo --format flycheck\", inputs: inputs, maintained: maintained, source_hashes: hashes, findings: rows}, pretty: true))\n[] = rows\nIO.puts(\"Credo #{Credo.version()}: #{length(maintained)} maintained inputs reconciled against #{length(inputs)} effective inputs; zero default-priority findings\")\n"
      ],
      "env": {
        "MIX_ENV": "test"
